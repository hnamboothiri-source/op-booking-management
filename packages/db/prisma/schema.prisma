enum AppointmentStatus {
  booked
  confirmed
  arrived
  waiting
  in_consultation
  completed
  cancelled
  no_show
  rescheduled
}

enum BookingSource {
  call_centre
  front_desk
  enquiry
  waitlist
  follow_up
  online
  camp
  mobile_clinic
}

enum SlotStatus {
  open
  full
  blocked
  cancelled
}

// M4 Patient relationship indicators
enum PatientCategory {
  new_patient
  repeat_patient
  high_value
  referred
  referring
  dormant
  at_risk
  vip
}

// M5 Consultation
enum ConsultationOutcome {
