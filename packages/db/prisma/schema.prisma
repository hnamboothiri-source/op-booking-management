}

// ===========================================================================
// CORE / MASTER DATA
// ===========================================================================

model Branch {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  location  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  doctorsSchedules DoctorSchedule[]
  timeSlots        TimeSlot[]
  bookings         OpBooking[]
  leads            Lead[]
  consultations    Consultation[]
  staff            StaffUser[]

  @@map("branches")
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  schedules     DoctorSchedule[]
  timeSlots     TimeSlot[]
  bookings      OpBooking[]
  consultations Consultation[]
  rooms         ConsultationRoom[]

  @@map("departments")
}

model Doctor {
  id              String   @id @default(uuid())
  name            String
  designation     String?
  role            String?  // chief_physician | dy_chief_physician | cmo | consultant | medical_officer | holistic | dietitian | yoga
  opDoctor        Boolean  @default(true) @map("op_doctor")
  registrationNo  String?  @unique @map("registration_no")
  dailyTarget     Int?     @map("daily_target")
  newTargetPct      Int    @default(70) @map("new_target_pct")      // % of capacity for new OP bookings
  followupTargetPct Int    @default(30) @map("followup_target_pct") // % of capacity for follow-up OP bookings
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  schedules      DoctorSchedule[]
  timeSlots      TimeSlot[]
  bookings       OpBooking[]
  consultations  Consultation[]
  followUps      FollowUp[]
  waitlistPrefs  WaitlistEntry[]
  leaves         DoctorLeave[]

  @@map("doctors")
}

model ConsultationRoom {
  id            String   @id @default(uuid())
  name          String
  code          String?  // e.g. "Room 7"
  purpose       String?  // consultation | initial_assessment | procedure | jalooka
  fixedDoctorId String?  @map("fixed_doctor_id") // permanent room for a chief, if any
  departmentId  String?  @map("department_id")
  branchId      String?  @map("branch_id")
  active        Boolean  @default(true)

  department Department? @relation(fields: [departmentId], references: [id])
  bookings   OpBooking[]

  @@map("consultation_rooms")
}

model StaffUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  role         Role
  branchId     String?  @map("branch_id")
  passwordHash String?  @map("password_hash")
  active       Boolean  @default(true)
  // Module slugs this user is a department manager of (orthogonal scope; see rbac.effectiveCan).
  managedModules String[] @default([]) @map("managed_modules")
  planRank     PlanRank @default(staff) @map("plan_rank") // maker/checker/approver tier
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  branch        Branch?        @relation(fields: [branchId], references: [id])
  ownedLeads    Lead[]         @relation("LeadOwner")
  assignedTasks Task[]         @relation("TaskAssignee")
  auditEvents   AuditLog[]

  @@index([role])
  @@map("staff_users")
}

model LeadSourceMaster {
  id     String  @id @default(uuid())
  name   String  @unique // e.g. social_media, google_ads, website, walk_in, camp ...
  group  String? // primary source group: digital | referral | camp | mobile_clinic | branch | walk_in
  active Boolean @default(true)

  leads Lead[]

  @@map("lead_sources")
}

model DiseaseMaster {
  id     String  @id @default(uuid())
  name   String  @unique
  active Boolean @default(true)

  leads         Lead[]
  consultations Consultation[]

  @@map("diseases")
}

model ServiceMaster {
  id     String  @id @default(uuid())
  name   String  @unique
  price  Int?    // paise
  active Boolean @default(true)

  @@map("services")
}

model ReferralSourceMaster {
  id     String  @id @default(uuid())
  name   String  @unique
  active Boolean @default(true)

  @@map("referral_sources")
}

model CommunicationTemplate {
  id        String               @id @default(uuid())
  name      String
  channel   CommunicationChannel
  language  String               @default("en")
  body      String
  active    Boolean              @default(true)
  createdAt DateTime             @default(now()) @map("created_at")

  messages CommunicationLog[]

  @@map("communication_templates")
}

model FollowUpTypeMaster {
  id     String       @id @default(uuid())
  name   String       @unique
  type   FollowUpType
  active Boolean      @default(true)

  @@map("follow_up_types")
}

model AdmissionPackageMaster {
  id            String  @id @default(uuid())
  name          String  @unique
  estimatedCost Int?    @map("estimated_cost") // paise
  active        Boolean @default(true)

  recommendations AdmissionRecommendation[]

  @@map("admission_packages")
}

model TaskTypeMaster {
  id     String   @id @default(uuid())
  name   String   @unique
  type   TaskType
  active Boolean  @default(true)

  @@map("task_types")
}

model ReasonMaster {
  id       String         @id @default(uuid())
  category ReasonCategory
  label    String
  active   Boolean        @default(true)

  @@unique([category, label])
  @@map("reasons")
}

// ===========================================================================
// SCHEDULING  (existing OP model — kept)
// ===========================================================================

model DoctorSchedule {
  id                  String    @id @default(uuid())
  doctorId            String    @map("doctor_id")
  departmentId        String    @map("department_id")
  branchId            String?   @map("branch_id")
  dayOfWeek           Int?      @map("day_of_week") // 0=Sun..6=Sat
  specificDate        DateTime? @map("specific_date") @db.Date
  session             String?   // morning | afternoon | full
  roomId              String?   @map("room_id")
  slotsCount          Int?      @map("slots_count") // patients per session ("nos")
  weekOfMonth         String?   @map("week_of_month") // e.g. "1,3"; null = every week
  startTime           String    @map("start_time")
  endTime             String    @map("end_time")
  slotDurationMinutes Int       @map("slot_duration_minutes")
  maxPatientsPerSlot  Int       @default(1) @map("max_patients_per_slot")
  active              Boolean   @default(true)
  validFrom           DateTime? @map("valid_from") @db.Date
  validUntil          DateTime? @map("valid_until") @db.Date

  doctor     Doctor     @relation(fields: [doctorId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])
  timeSlots  TimeSlot[]

  planRef String? @map("plan_ref")
  @@map("doctor_schedules")
}

model TimeSlot {
  id           String     @id @default(uuid())
  doctorId     String     @map("doctor_id")
  departmentId String     @map("department_id")
  branchId     String?    @map("branch_id")
  scheduleId   String?    @map("schedule_id")
  roomId       String?    @map("room_id")
  slotDate     DateTime   @map("slot_date") @db.Date
  startTime    String     @map("start_time")
  endTime      String     @map("end_time")
  capacity     Int
  bookedCount  Int        @default(0) @map("booked_count")
  status       SlotStatus @default(open)
  createdAt    DateTime   @default(now()) @map("created_at")

  doctor     Doctor          @relation(fields: [doctorId], references: [id])
  department Department      @relation(fields: [departmentId], references: [id])
  branch     Branch?         @relation(fields: [branchId], references: [id])
  schedule   DoctorSchedule? @relation(fields: [scheduleId], references: [id])
  bookings   OpBooking[]

  @@index([slotDate, doctorId])
  @@map("time_slots")
}

// ===========================================================================
// PATIENT  (HIS cache, extended toward 360 profile — M4)
// ===========================================================================

model Patient {
  mrd              String    @id
  name             String
  phone            String?
  whatsapp         String?
  alternatePhone   String?   @map("alternate_phone")
  email            String?
  place            String?
  address          String?
  gender           Gender?
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  occupation       String?
  languagePref     String?   @map("language_pref")
  isNew            Boolean   @default(true) @map("is_new")
  firstVisitSource String?   @map("first_visit_source")
  category         PatientCategory @default(new_patient)
  lifetimeVisits   Int       @default(0) @map("lifetime_visits")
  lifetimeRevenue  Int       @default(0) @map("lifetime_revenue") // paise
  lastVisitDate    DateTime? @map("last_visit_date") @db.Date
  consentWhatsapp  Boolean   @default(false) @map("consent_whatsapp")
  consentSms       Boolean   @default(false) @map("consent_sms")
  consentEmail     Boolean   @default(false) @map("consent_email")
  hisSyncedAt      DateTime? @map("his_synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  bookings        OpBooking[]
  leads           Lead[]
  consultations   Consultation[]
  followUps       FollowUp[]
  waitlistEntries WaitlistEntry[]
  referralsGiven  Referral[]      @relation("ReferrerPatient")
  referralsGot    Referral[]      @relation("ReferredPatient")
  communications  CommunicationLog[]
  admissionRecs   AdmissionRecommendation[]
  scores          PatientScore[]
  retention       RetentionStatus?
  family          FamilyMember[]
  documents       PatientDocument[]
  campPatients    CampPatient[]
  mobilePatients  MobileClinicPatient[]
  medicationCourses   MedicationCourse[]
  medicationReminders MedicationReminder[]
  therapyPlans        TherapyPlan[]
  therapySessions     TherapySession[]

  @@index([phone])
  @@index([category])
  @@map("patients")
}

model FamilyMember {
  id          String  @id @default(uuid())
  patientMrd  String  @map("patient_mrd")
  name        String
  relation    String?
  phone       String?

  patient Patient @relation(fields: [patientMrd], references: [mrd])

  @@map("family_members")
}

model PatientDocument {
  id         String   @id @default(uuid())
  patientMrd String   @map("patient_mrd")
  label      String
  url        String
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  patient Patient @relation(fields: [patientMrd], references: [mrd])

  @@map("patient_documents")
}

// ===========================================================================
// AYURVEDA ENGAGEMENT — medicine adherence + therapy/Panchakarma tracking
// ===========================================================================

enum MedicationCourseStatus {
  active
  completed
  discontinued
}
enum AdherenceState {
  unknown
  on_track
  missed_doses
  needs_refill
  side_effects
  needs_consult
}
enum MedicationReminderKind {
  start
  compliance
  refill
}
enum MedicationReminderStatus {
  scheduled
  sent
  done
}
enum TherapyType {
  panchakarma
  abhyanga
  shirodhara
  njavarakizhi
  kativasthi
  other
}
enum TherapyPlanStatus {
  planned
  in_progress
  completed
  discontinued
}
enum TherapySessionStatus {
  scheduled
  completed
  missed
  cancelled
}

model MedicationCourse {
  id             String                 @id @default(uuid())
  patientMrd     String                 @map("patient_mrd")
  consultationId String?                @map("consultation_id")
  doctorId       String?                @map("doctor_id")
  medicine       String
  durationDays   Int                    @map("duration_days")
  startDate      DateTime               @map("start_date") @db.Date
  status         MedicationCourseStatus @default(active)
  adherence      AdherenceState         @default(unknown)
  lastResponseAt DateTime?              @map("last_response_at")
  notes          String?
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  patient   Patient              @relation(fields: [patientMrd], references: [mrd])
  reminders MedicationReminder[]

  @@index([patientMrd, status])
  @@map("medication_courses")
}

model MedicationReminder {
  id         String                   @id @default(uuid())
  courseId   String                   @map("course_id")
  patientMrd String                   @map("patient_mrd")
  kind       MedicationReminderKind
  dueDate    DateTime                 @map("due_date") @db.Date
  status     MedicationReminderStatus @default(scheduled)
  sentAt     DateTime?                @map("sent_at")
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")

  course  MedicationCourse @relation(fields: [courseId], references: [id])
  patient Patient          @relation(fields: [patientMrd], references: [mrd])

  @@index([patientMrd, status])
  @@index([courseId])
  @@index([dueDate])
  @@map("medication_reminders")
}

model TherapyPlan {
  id             String            @id @default(uuid())
  patientMrd     String            @map("patient_mrd")
  consultationId String?           @map("consultation_id")
  doctorId       String?           @map("doctor_id")
  therapyType    TherapyType       @map("therapy_type")
  name           String?
  totalSessions  Int               @map("total_sessions")
  status         TherapyPlanStatus @default(planned)
  startDate      DateTime          @map("start_date") @db.Date
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  patient  Patient          @relation(fields: [patientMrd], references: [mrd])
  sessions TherapySession[]

  @@index([patientMrd, status])
  @@map("therapy_plans")
}

model TherapySession {
  id            String               @id @default(uuid())
  planId        String               @map("plan_id")
  patientMrd    String               @map("patient_mrd")
  sessionNo     Int                  @map("session_no")
  scheduledDate DateTime             @map("scheduled_date") @db.Date
  status        TherapySessionStatus @default(scheduled)
  completedAt   DateTime?            @map("completed_at")
  notes         String?
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  plan    TherapyPlan @relation(fields: [planId], references: [id])
  patient Patient     @relation(fields: [patientMrd], references: [mrd])

  @@index([patientMrd, status])
  @@index([planId])
  @@map("therapy_sessions")
}

// ===========================================================================
// M1 LEAD  (generalizes the lightweight Enquiry path)
// ===========================================================================

model Lead {
  id              String       @id @default(uuid())
  leadNumber      String?      @map("lead_number") // display id e.g. LEAD-2026-000123
  contactName     String       @map("contact_name")
  phone           String
  whatsapp        String?
  email           String?
  gender          Gender?
  age             Int?
  city            String?
  district        String?
  chiefComplaint  String?      @map("chief_complaint")
  previousTreatment Boolean?   @map("previous_treatment")
  existingPatient Boolean?     @map("existing_patient")
  patientMrd      String?      @map("patient_mrd") // set when converted/known
  sourceId        String?      @map("source_id")
  secondarySource String?      @map("secondary_source")
  responseChannel String?      @map("response_channel") // call | whatsapp | email | walk_in
  campaignId      String?      @map("campaign_id")
  diseaseId       String?      @map("disease_id")
  branchId        String?      @map("branch_id")
  preferredDoctor String?      @map("preferred_doctor")
  priority        LeadPriority @default(medium)
  priorityTier    String?      @map("priority_tier") // manual override: hot | warm | cold
  ownerId         String?      @map("owner_id")
  assignedAt      DateTime?    @map("assigned_at")
  stage           LeadStage    @default(new_lead)
  followUpDate    DateTime?    @map("follow_up_date") @db.Date
  lastCallOutcome CallOutcome? @map("last_call_outcome")
  lastContactAt   DateTime?    @map("last_contact_at")
  closureReason   String?      @map("closure_reason")
  mergedIntoId    String?      @map("merged_into_id")
  missedEnquiry   Boolean      @default(false) @map("missed_enquiry")
  desk            String?      // call-centre desk: reception | front_office | back_office
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  source      LeadSourceMaster?  @relation(fields: [sourceId], references: [id])
  campaign    Campaign?          @relation(fields: [campaignId], references: [id])
  disease     DiseaseMaster?     @relation(fields: [diseaseId], references: [id])
  branch      Branch?            @relation(fields: [branchId], references: [id])
  owner       StaffUser?         @relation("LeadOwner", fields: [ownerId], references: [id])
  patient     Patient?           @relation(fields: [patientMrd], references: [mrd])
  mergedInto  Lead?              @relation("LeadMerge", fields: [mergedIntoId], references: [id])
  mergedFrom  Lead[]             @relation("LeadMerge")
  calls       CallLog[]
  bookings    OpBooking[]
  tasks       Task[]
  activities  LeadActivity[]
  assignments LeadAssignment[]
  communications CommunicationLog[]

  @@index([stage])
  @@index([phone])
  @@index([sourceId])
  @@index([ownerId])
  planRef         String?      @map("plan_ref")
  @@map("leads")
}

// Unified per-lead activity timeline (calls, messages, stage changes, notes, …)
model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  kind      String   // created | assigned | call | message | stage_change | note | follow_up | transfer | merge
  summary   String
  detail    String?
  actorId   String?  @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

// Assignment / transfer history for a lead (owner and/or branch changes)
model LeadAssignment {
  id          String   @id @default(uuid())
  leadId      String   @map("lead_id")
  fromOwnerId String?  @map("from_owner_id")
  toOwnerId   String?  @map("to_owner_id")
  fromBranchId String? @map("from_branch_id")
  toBranchId  String?  @map("to_branch_id")
  reason      String?
  actorId     String?  @map("actor_id")
  createdAt   DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId, createdAt])
  @@map("lead_assignments")
}

model CallLog {
  id        String      @id @default(uuid())
  leadId    String?     @map("lead_id")
  patientMrd String?    @map("patient_mrd")
  followUpId String?    @map("follow_up_id")
  executiveId String?   @map("executive_id")
  desk      String?
  outcome   CallOutcome
  notes     String?
  nextAction String?    @map("next_action")
  checklistJson String? @map("checklist_json")
  durationSec Int?      @map("duration_sec")
  recordingUrl String?  @map("recording_url")
  createdAt DateTime    @default(now()) @map("created_at")

  lead Lead? @relation(fields: [leadId], references: [id])

  @@index([executiveId, createdAt])
  @@map("call_logs")
}

/// Configurable per-desk call talking-points / checklist (Module 2 — call centre).
model CallChecklistItem {
  id           String   @id @default(uuid())
  label        String
  desk         String?  // reception | front_office | back_office | any
  section      String?  // identity | clinical | commercial | next_step | general
  promptHint   String?  @map("prompt_hint")
  mandatory    Boolean  @default(false)
  responseType String?  @default("checkbox") @map("response_type") // checkbox | yes_no_na | short_text
  sortOrder    Int      @default(0) @map("sort_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("call_checklist_items")
}

// Lightweight enquiry kept for non-lead quick logging (front desk)
model Enquiry {
  id                 String        @id @default(uuid())
  contactName        String        @map("contact_name")
  phone              String
  mrd                String?
  departmentId       String?       @map("department_id")
  preferredDate      DateTime?     @map("preferred_date") @db.Date
  source             BookingSource @default(front_desk)
  handler            String?
  status             EnquiryStatus @default(open)
  notes              String?
  convertedBookingId String?       @map("converted_booking_id")
  createdAt          DateTime      @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("enquiries")
}

// ===========================================================================
// M3 APPOINTMENT
// ===========================================================================

model OpBooking {
  id                 String            @id @default(uuid())
  bookingRef         String            @unique @map("booking_ref")
  patientMrd         String            @map("patient_mrd")
  doctorId           String            @map("doctor_id")
  departmentId       String            @map("department_id")
  branchId           String?           @map("branch_id")
  timeSlotId         String?           @map("time_slot_id")
  roomId             String?           @map("room_id")
  leadId             String?           @map("lead_id")
  appointmentDate    DateTime          @map("appointment_date") @db.Date
  startTime          String            @map("start_time")
  endTime            String?           @map("end_time")
  status             AppointmentStatus @default(booked)
  source             BookingSource
  appointmentType    String?           @map("appointment_type") // regular | follow_up | emergency | senior | teleconsultation | camp_follow_up
  requestedDoctorId  String?           @map("requested_doctor_id") // doctor the patient asked for (call-centre conversion tracking)
  noPreference       Boolean           @default(false) @map("no_preference") // patient asked for no specific doctor
  queueToken         Int?              @map("queue_token")
  bookedBy           String?           @map("booked_by")
  bookedAt           DateTime          @default(now()) @map("booked_at")
  checkedInAt        DateTime?         @map("checked_in_at")
  completedAt        DateTime?         @map("completed_at")
  cancelledAt        DateTime?         @map("cancelled_at")
  cancellationReason String?           @map("cancellation_reason")
  cancellationReasonId String?         @map("cancellation_reason_id")
  rescheduleReason   String?           @map("reschedule_reason")
  rescheduleReasonId String?           @map("reschedule_reason_id")
  chiefComplaint     String?           @map("chief_complaint")
  bp                 String?
  pulseBpm           Int?              @map("pulse_bpm")
  notes              String?
  enquiryId          String?           @map("enquiry_id")
  waitlistId         String?           @map("waitlist_id")
  rescheduledFromId  String?           @map("rescheduled_from_id")

  patient      Patient           @relation(fields: [patientMrd], references: [mrd])
  doctor       Doctor            @relation(fields: [doctorId], references: [id])
  department   Department        @relation(fields: [departmentId], references: [id])
  branch       Branch?           @relation(fields: [branchId], references: [id])
  timeSlot     TimeSlot?         @relation(fields: [timeSlotId], references: [id])
  room         ConsultationRoom? @relation(fields: [roomId], references: [id])
  lead         Lead?             @relation(fields: [leadId], references: [id])
  rescheduledFrom OpBooking?  @relation("Reschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo   OpBooking[] @relation("Reschedule")
  consultation Consultation?
  followUps    FollowUp[]
  statusHistory AppointmentStatusHistory[]
  reminders     AppointmentReminder[]

  @@index([appointmentDate, departmentId])
  @@index([doctorId, appointmentDate])
  @@index([patientMrd])
  @@index([status])
  @@map("op_bookings")
}

// Status-transition audit for an appointment (FRS §16 / §19).
model AppointmentStatusHistory {
  id         String   @id @default(uuid())
  bookingId  String   @map("booking_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  reason     String?
  actorId    String?  @map("actor_id")
  createdAt  DateTime @default(now()) @map("created_at")

  booking OpBooking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, createdAt])
  @@map("appointment_status_history")
}

// Scheduled appointment reminder (FRS §14). The timed scheduler is backend-deferred;
// the daily cron fills/sends these against the mock in the prototype.
model AppointmentReminder {
  id           String    @id @default(uuid())
  bookingId    String    @map("booking_id")
  kind         String    // booking | day_before | morning
  channel      String    @default("whatsapp")
  scheduledFor DateTime  @map("scheduled_for")
  sentAt       DateTime? @map("sent_at")
  status       String    @default("scheduled") // scheduled | sent | failed
  createdAt    DateTime  @default(now()) @map("created_at")

  booking OpBooking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("appointment_reminders")
}

// Doctor leave / emergency block — overlapping slots are marked blocked (FRS §4).
model DoctorLeave {
  id        String   @id @default(uuid())
  doctorId  String   @map("doctor_id")
  branchId  String?  @map("branch_id")
  fromDate  DateTime @map("from_date") @db.Date
  toDate    DateTime @map("to_date") @db.Date
  kind      String   @default("leave") // leave | emergency_block
  reason    String?
  coverDoctorId String? @map("cover_doctor_id") // substitute who takes the on-leave doctor's slots
  createdAt DateTime @default(now()) @map("created_at")

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@index([doctorId, fromDate])
  @@map("doctor_leaves")
}

model WaitlistEntry {
  id                  String         @id @default(uuid())
  patientMrd          String         @map("patient_mrd")
  doctorId            String?        @map("doctor_id")
  departmentId        String         @map("department_id")
  requestedDate       DateTime       @map("requested_date") @db.Date
  fallbackDates       DateTime[]     @map("fallback_dates") @db.Date
  fallbackDeptIds     String[]       @map("fallback_department_ids")
  priority            Int            @default(0)
  status              WaitlistStatus @default(waiting)
  promotedBookingId   String?        @map("promoted_booking_id")
  createdAt           DateTime       @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientMrd], references: [mrd])
  doctor  Doctor? @relation(fields: [doctorId], references: [id])

  @@index([requestedDate, departmentId, status])
  @@map("waitlist_entries")
}

// ===========================================================================
// M5 CONSULTATION  (coordination — not full EMR)
// ===========================================================================

model Consultation {
  id            String              @id @default(uuid())
  bookingId     String              @unique @map("booking_id")
  patientMrd    String              @map("patient_mrd")
  doctorId      String              @map("doctor_id")
  departmentId  String              @map("department_id")
  branchId      String?             @map("branch_id")
  diseaseId     String?             @map("disease_id")
  notes         String?
  diagnosis     String?
  advice        String?
  outcome       ConsultationOutcome
  bp            String?
  pulseBpm      Int?                @map("pulse_bpm")
  weightKg      Int?                @map("weight_kg")
  spo2          Int?
  staffRemarks  String?             @map("staff_remarks") // for call centre / front office
  createdAt     DateTime            @default(now()) @map("created_at")

  booking          OpBooking                 @relation(fields: [bookingId], references: [id])
  patient          Patient                   @relation(fields: [patientMrd], references: [mrd])
  doctor           Doctor                    @relation(fields: [doctorId], references: [id])
  department       Department                @relation(fields: [departmentId], references: [id])
  branch           Branch?                   @relation(fields: [branchId], references: [id])
  disease          DiseaseMaster?            @relation(fields: [diseaseId], references: [id])
  prescriptions    Prescription[]
  labReferrals     LabReferral[]
  optoReferrals    OptometryReferral[]
  admissionRecs    AdmissionRecommendation[]
  treatmentPlan    TreatmentPlan?
  referralsOut     Referral[]                @relation("ConsultationReferral")
  followUps        FollowUp[]

  @@index([doctorId, createdAt])
  @@map("consultations")
}

model Prescription {
  id             String   @id @default(uuid())
  consultationId String   @map("consultation_id")
  summary        String   // summary only — full Rx lives in HIS
  createdAt      DateTime @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@map("prescriptions")
}

model LabReferral {
  id             String   @id @default(uuid())
  consultationId String   @map("consultation_id")
  testName       String   @map("test_name")
  status         FollowUpStatus @default(pending)
  createdAt      DateTime @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@map("lab_referrals")
}

model OptometryReferral {
  id             String   @id @default(uuid())
  consultationId String   @map("consultation_id")
  reason         String?
  status         FollowUpStatus @default(pending)
  createdAt      DateTime @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@map("optometry_referrals")
}

model TreatmentPlan {
  id             String          @id @default(uuid())
  consultationId String          @unique @map("consultation_id")
  summary        String
  durationDays   Int?            @map("duration_days")
  status         TreatmentStatus @default(planned)
  startedAt      DateTime?       @map("started_at")
  completedAt    DateTime?       @map("completed_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@index([status])
  @@map("treatment_plans")
}

// ===========================================================================
// M10 ADMISSION CONVERSION
// ===========================================================================

model AdmissionRecommendation {
  id               String                    @id @default(uuid())
  patientMrd       String                    @map("patient_mrd")
  consultationId   String?                   @map("consultation_id")
  doctorId         String?                   @map("doctor_id")
  packageId        String?                   @map("package_id")
  estimatedCost    Int?                      @map("estimated_cost") // paise
  status           AdmissionStatus           @default(recommended)
  rejectionReason  AdmissionRejectionReason? @map("rejection_reason")
  counsellorId     String?                   @map("counsellor_id")
  counsellingNotes String?                   @map("counselling_notes")
  costDiscussed    Int?                      @map("cost_discussed") // paise
  nextCounsellingAt DateTime?                @map("next_counselling_at")
  decisionAt       DateTime?                 @map("decision_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  patient      Patient                 @relation(fields: [patientMrd], references: [mrd])
  consultation Consultation?           @relation(fields: [consultationId], references: [id])
  package      AdmissionPackageMaster? @relation(fields: [packageId], references: [id])
  tasks        Task[]

  @@index([status])
  @@map("admission_recommendations")
}

// ===========================================================================
// M6 REFERRAL
// ===========================================================================

model Referral {
  id                 String         @id @default(uuid())
  type               ReferralType
  referrerPatientMrd String?        @map("referrer_patient_mrd")
  referrerName       String?        @map("referrer_name") // external doctor / org contact
  organizationId     String?        @map("organization_id")
  referredPatientMrd String?        @map("referred_patient_mrd")
  consultationId     String?        @map("consultation_id")
  branchId           String?        @map("branch_id")
  status             ReferralStatus @default(pending)
  rewardEligible     Boolean        @default(false) @map("reward_eligible")
  revenue            Int            @default(0) // paise attributed
  createdAt          DateTime       @default(now()) @map("created_at")

  referrerPatient Patient?      @relation("ReferrerPatient", fields: [referrerPatientMrd], references: [mrd])
  referredPatient Patient?      @relation("ReferredPatient", fields: [referredPatientMrd], references: [mrd])
  organization    Organization? @relation(fields: [organizationId], references: [id])
  consultation    Consultation? @relation("ConsultationReferral", fields: [consultationId], references: [id])

  @@index([type, status])
  planRef            String?        @map("plan_ref")
  @@map("referrals")
}

// ===========================================================================
// M9 FOLLOW-UP
// ===========================================================================

model FollowUp {
  id              String         @id @default(uuid())
  patientMrd      String         @map("patient_mrd")
  departmentId    String?        @map("department_id")
  doctorId        String?        @map("doctor_id")
  consultationId  String?        @map("consultation_id")
  originBookingId String?        @map("origin_booking_id")
  linkedBookingId String?        @map("linked_booking_id")
  type            FollowUpType
  dueDate         DateTime       @map("due_date") @db.Date
  priority        TaskPriority   @default(medium)
  ownerId         String?        @map("owner_id")
  status          FollowUpStatus @default(pending)
  completedAt     DateTime?      @map("completed_at")
  callOutcome     CallOutcome?   @map("call_outcome")
  closureReason   String?        @map("closure_reason")
  desk            String?        // call-centre desk: front_office (patient review)
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientMrd], references: [mrd])
  doctor       Doctor?       @relation(fields: [doctorId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])
  origin       OpBooking?    @relation(fields: [originBookingId], references: [id])
  tasks        Task[]

  planRef         String?        @map("plan_ref")
  @@index([dueDate, status])
  @@index([ownerId])
  @@map("follow_ups")
}

// ===========================================================================
// M15 TASK & WORKFLOW
// ===========================================================================

model Task {
  id            String       @id @default(uuid())
  type          TaskType
  subject       String
  assigneeId    String?      @map("assignee_id")
  patientMrd    String?      @map("patient_mrd")
  leadId        String?      @map("lead_id")
  followUpId    String?      @map("follow_up_id")
  admissionRecId String?     @map("admission_rec_id")
  dueDate       DateTime?    @map("due_date") @db.Date
  priority      TaskPriority @default(medium)
  status        TaskStatus   @default(open)
  remarks       String?
  outcome       String?      // outcome code captured on completion / escalation
  escalatedToId String?      @map("escalated_to_id")
  completedAt   DateTime?    @map("completed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  assignee     StaffUser?               @relation("TaskAssignee", fields: [assigneeId], references: [id])
  lead         Lead?                    @relation(fields: [leadId], references: [id])
  followUp     FollowUp?                @relation(fields: [followUpId], references: [id])
  admissionRec AdmissionRecommendation? @relation(fields: [admissionRecId], references: [id])

  @@index([assigneeId, status])
  @@index([dueDate, status])
  @@map("tasks")
}

// Department/module-level plan — objectives, targets, budget, time frame, activities.
model ModulePlan {
  id            String     @id @default(uuid())
  moduleSlug    String     @map("module_slug")
  title         String
  period        String?                              // e.g. "2026-Q3"
  periodStart   DateTime?  @map("period_start") @db.Date
  periodEnd     DateTime?  @map("period_end") @db.Date
  objective     String?
  status        PlanStatus @default(draft)
  ownerId       String?    @map("owner_id")
  plannedBudget Int        @default(0) @map("planned_budget") // paise
  targets       Json?                                // TargetLine[]
  activities    Json?                                // ActivityLine[]
  budgetBreakdown Json?    @map("budget_breakdown")   // { [monthLabel]: paise } for yearly+monthlyBudget
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([moduleSlug, status])
  @@map("module_plans")
}

// ===========================================================================
// MODULE CONFIGURATION — runtime, admin-editable per-module config
// ===========================================================================

// A per-module master definition (a stored row of the MASTERS registry).
model ModuleMaster {
  id          String   @id @default(uuid())
  moduleSlug  String   @map("module_slug")
  key         String                               // unique within the module, e.g. "clinic-venues"
  label       String
  fields      Json                                 // FieldDef[]
  listColumns Json     @map("list_columns")         // string[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([moduleSlug, key])
  @@map("module_masters")
}

// One generic table for ALL custom-master rows (avoids a model per master).
model CustomRecord {
  id         String   @id @default(uuid())
  moduleSlug String   @map("module_slug")
  masterKey  String   @map("master_key")
  data       Json                                  // { [fieldName]: value }, money in paise, dates ISO
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([moduleSlug, masterKey])
  @@map("custom_records")
}

// Per-module planning configuration (cadence + custom entry/report fields).
model PlanConfig {
  id            String   @id @default(uuid())
  moduleSlug    String   @unique @map("module_slug")
  cadence       String   @default("quarterly")      // yearly|quarterly|monthly|half_yearly|custom
  monthlyBudget Boolean  @default(false) @map("monthly_budget")
  entryFields   Json     @map("entry_fields")        // FieldDef[]
  reportColumns Json     @map("report_columns")      // FieldDef[]
  flowSteps     Json     @default("[]") @map("flow_steps") // FlowStep[] — admin override of the built-in module flow
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("plan_configs")
}

// ===========================================================================
// M11 COMMUNICATION
// ===========================================================================

model CommunicationLog {
  id          String               @id @default(uuid())
  patientMrd  String?              @map("patient_mrd")
  leadId      String?              @map("lead_id")
  channel     CommunicationChannel
  templateId  String?              @map("template_id")
  campaignId  String?              @map("campaign_id")
  toAddress   String               @map("to_address")
  body        String?
  status      CommunicationStatus  @default(queued)
  sentAt      DateTime?            @map("sent_at")
  deliveredAt DateTime?            @map("delivered_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  patient  Patient?               @relation(fields: [patientMrd], references: [mrd])
  lead     Lead?                  @relation(fields: [leadId], references: [id])
  template CommunicationTemplate? @relation(fields: [templateId], references: [id])
  campaign Campaign?              @relation(fields: [campaignId], references: [id])

  @@index([patientMrd])
  @@index([status])
  planRef     String?              @map("plan_ref")
  @@map("communication_logs")
}

// ===========================================================================
// M13 MARKETING CAMPAIGN
// ===========================================================================

model Campaign {
  id             String       @id @default(uuid())
  name           String
  type           CampaignType
  budget         Int          @default(0) // paise
  sourceId       String?      @map("source_id")
  startDate      DateTime?    @map("start_date") @db.Date
  endDate        DateTime?    @map("end_date") @db.Date
  targetLocation String?      @map("target_location") // outreach area
  targetDistrict String?      @map("target_district")
  targetDisease  String?      @map("target_disease")
  targetAgeMin   Int?         @map("target_age_min")
  targetAgeMax   Int?         @map("target_age_max")
  targetGender   String?      @map("target_gender") // male | female | all
  targetAudience String?      @map("target_audience") // traits / description
  status         String       @default("planned") // planned | running | completed
  launchedAt     DateTime?    @map("launched_at")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")

  channels       CampaignChannel[]
  leads          Lead[]
  communications CommunicationLog[]

  planRef        String?      @map("plan_ref")
  @@map("campaigns")
}

// A social/media channel line-item within a campaign, with the agency's assured
// reach quote (FRS §3-5): promised vs achieved reach + quoted cost.
model CampaignChannel {
  id              String   @id @default(uuid())
  campaignId      String   @map("campaign_id")
  channel         String   // youtube | instagram | google_ads | facebook | whatsapp | newspaper | tv | radio | other
  channelMasterId String?  @map("channel_master_id")
  promisedReach   Int      @default(0) @map("promised_reach")
  achievedReach   Int?     @map("achieved_reach")
  quotedCost      Int      @default(0) @map("quoted_cost") // paise
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  campaign      Campaign               @relation(fields: [campaignId], references: [id])
  channelMaster MarketingChannelMaster? @relation(fields: [channelMasterId], references: [id])

  @@index([campaignId])
  @@map("campaign_channels")
}

// Master of social/media channels with their pricing pattern (rate card).
model MarketingChannelMaster {
  id           String   @id @default(uuid())
  name         String   // Instagram | Facebook | WhatsApp | YouTube | Google Ads | ...
  pricingModel String   @default("cpm") // cpm (per 1,000 reach) | cpc | flat | per_post
  baseRate     Int      @default(0) @map("base_rate") // paise
  minReach     Int?     @map("min_reach")
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  offers          ChannelSeasonalOffer[]
  campaignChannels CampaignChannel[]

  @@map("marketing_channel_masters")
}

// Seasonal offer on a channel: a discount and/or bonus reach during a date window.
model ChannelSeasonalOffer {
  id              String   @id @default(uuid())
  channelMasterId String   @map("channel_master_id")
  name            String
  fromDate        DateTime @map("from_date") @db.Date
  toDate          DateTime @map("to_date") @db.Date
  discountPct     Int?     @map("discount_pct")
  bonusReachPct   Int?     @map("bonus_reach_pct")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  channel MarketingChannelMaster @relation(fields: [channelMasterId], references: [id])

  @@index([channelMasterId])
  @@map("channel_seasonal_offers")
}

// ===========================================================================
// M7 CAMP / M8 MOBILE CLINIC / M14 ORGANIZATION (OUTREACH)
// ===========================================================================

model Organization {
  id              String           @id @default(uuid())
  name            String
  type            OrganizationType
  contactPersons  Json?            @map("contact_persons")
  relationOwnerId String?          @map("relation_owner_id")
  nextEngagement  DateTime?        @map("next_engagement") @db.Date
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")

  camps       Camp[]
  referrals   Referral[]
  engagements OrganizationEngagement[]

  @@map("organizations")
}

/// Logged engagement touch-point with an institution (Phase 24 capture).
model OrganizationEngagement {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  type           String   // visit | call | email | meeting
  outcome        String
  notes          String?
  actorId        String?  @map("actor_id")
  at             DateTime @default(now())
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, at])
  @@map("organization_engagements")
}

model Camp {
  id             String       @id @default(uuid())
  name           String
  location       String?                                // locality / town
  venue          String?                                // auditorium / place name
  venueCapacity  Int?         @map("venue_capacity")
  branchId       String?      @map("branch_id")        // owning branch (main hospital or a branch)
  diseaseId      String?      @map("disease_id")        // target disease/focus
  expectedAdmissions Int?     @map("expected_admissions")
  organizerId    String?      @map("organizer_id")
  coordinatorId  String?      @map("coordinator_id")
  scheduledAt    DateTime?    @map("scheduled_at")
  status         CampStatus   @default(planned)
  isRecurring    Boolean      @default(false) @map("is_recurring")
  parentId       String?      @map("parent_id")         // a recurring series' first camp
  expectedPatients Int?       @map("expected_patients")
  staffAssigned  Json?        @map("staff_assigned")    // deprecated → staffRoster
  staffRoster    Json?        @map("staff_roster")      // OutreachStaffLine[]
  expenses       Json?        // OutreachExpenseLine[] (planned vs actual)
  revenueLines   Json?        @map("revenue_lines")     // OutreachRevenueLine[] (on-site income)
  planning       Json?        // PlanningChecklist
  patientsScreened Int        @default(0) @map("patients_screened")
  revenue        Int          @default(0) // paise from camp patients
  createdAt      DateTime     @default(now()) @map("created_at")

  organizer    Organization? @relation(fields: [organizerId], references: [id])
  parent       Camp?         @relation("CampSeries", fields: [parentId], references: [id])
  children     Camp[]        @relation("CampSeries")
  campPatients CampPatient[]

  planRef        String?      @map("plan_ref")
  @@index([branchId])
  @@map("camps")
}

model CampPatient {
  id              String   @id @default(uuid())
  campId          String   @map("camp_id")
  patientMrd      String?  @map("patient_mrd")
  contactName     String   @map("contact_name")
  phone           String?
  age             Int?
  gender          Gender?
  complaint       String?
  diseaseId       String?  @map("disease_id")
  recommendedVisit Boolean @default(false) @map("recommended_visit")
  bookingId       String?  @map("booking_id")
  leadId          String?  @map("lead_id")  // the auto-created lead (downstream ROI tracing)
  createdAt       DateTime @default(now()) @map("created_at")

  camp    Camp     @relation(fields: [campId], references: [id])
  patient Patient? @relation(fields: [patientMrd], references: [mrd])

  @@map("camp_patients")
}

model MobileClinic {
  id            String     @id @default(uuid())
  routeName     String     @map("route_name")
  location      String?
  venue         String?
  venueCapacity Int?       @map("venue_capacity")
  branchId      String?    @map("branch_id")
  diseaseId     String?    @map("disease_id")
  coordinatorId String?    @map("coordinator_id")
  scheduledAt   DateTime?  @map("scheduled_at")
  status        CampStatus @default(planned)
  isRecurring   Boolean    @default(false) @map("is_recurring")
  expectedPatients Int?    @map("expected_patients")
  expectedAdmissions Int?  @map("expected_admissions")
  staffRoster   Json?      @map("staff_roster")    // OutreachStaffLine[]
  expenses      Json?      // OutreachExpenseLine[]
  revenueLines  Json?      @map("revenue_lines")    // OutreachRevenueLine[]
  planning      Json?      // PlanningChecklist
  patientsScreened Int     @default(0) @map("patients_screened")
  revenue       Int        @default(0) // paise
  createdAt     DateTime   @default(now()) @map("created_at")

  patients MobileClinicPatient[]

  planRef String? @map("plan_ref")
  @@index([branchId])
  @@map("mobile_clinics")
}

model MobileClinicPatient {
  id              String   @id @default(uuid())
  mobileClinicId  String   @map("mobile_clinic_id")
  patientMrd      String?  @map("patient_mrd")
  contactName     String   @map("contact_name")
  phone           String?
  age             Int?
  gender          Gender?
  complaint       String?
  diseaseId       String?  @map("disease_id")
  referredToBranch Boolean @default(false) @map("referred_to_branch")
  bookingId       String?  @map("booking_id")
  leadId          String?  @map("lead_id")  // the auto-created lead (downstream ROI tracing)
  createdAt       DateTime @default(now()) @map("created_at")

  mobileClinic MobileClinic @relation(fields: [mobileClinicId], references: [id])
  patient      Patient?     @relation(fields: [patientMrd], references: [mrd])

  @@map("mobile_clinic_patients")
}

// ===========================================================================
// M12 RETENTION & SCORING
// ===========================================================================

model PatientScore {
  id         String   @id @default(uuid())
  patientMrd String   @map("patient_mrd")
  kind       String   // "retention" | "conversion"
  score      Int
  factors    Json?    // breakdown for explainability
  computedAt DateTime @default(now()) @map("computed_at")

  patient Patient @relation(fields: [patientMrd], references: [mrd])

  @@index([patientMrd, kind])
  @@map("patient_scores")
}

model RetentionStatus {
  patientMrd      String            @id @map("patient_mrd")
  category        RetentionCategory @default(active)
  riskScore       Int               @default(0) @map("risk_score")
  successOwnerId  String?           @map("success_owner_id")
  reactivationMethod String?        @map("reactivation_method") // call | whatsapp | visit | email
  reactivationResult String?        @map("reactivation_result") // promised_visit | booked | not_interested | unreachable | do_not_contact
  reactivationNote   String?        @map("reactivation_note")
  reactivatedAt      DateTime?      @map("reactivated_at")
  lastEvaluatedAt DateTime          @default(now()) @map("last_evaluated_at")

  patient Patient @relation(fields: [patientMrd], references: [mrd])

  @@index([category])
  planRef       String?  @map("plan_ref")
  @@map("retention_status")
}

model PatientSegment {
  id        String   @id @default(uuid())
  name      String   @unique
  rule      Json     // segment definition
  createdAt DateTime @default(now()) @map("created_at")

  @@map("patient_segments")
}

// ===========================================================================
// ANALYTICS ROLLUPS  (materialized by nightly jobs — Phase 4)
// ===========================================================================

model DailyKPI {
  id              String   @id @default(uuid())
  date            DateTime @db.Date
  branchId        String?  @map("branch_id")
  leads           Int      @default(0)
  appointments    Int      @default(0)
  consultations   Int      @default(0)
  admissions      Int      @default(0)
  revenue         Int      @default(0)

  @@unique([date, branchId])
  @@map("daily_kpi")
}

model BranchKPI {
  id            String   @id @default(uuid())
  branchId      String   @map("branch_id")
  periodStart   DateTime @map("period_start") @db.Date
  periodEnd     DateTime @map("period_end") @db.Date
  leads         Int      @default(0)
  appointments  Int      @default(0)
  consultations Int      @default(0)
  admissions    Int      @default(0)
  revenue       Int      @default(0)

  @@map("branch_kpi")
}

model DoctorKPI {
  id             String   @id @default(uuid())
  doctorId       String   @map("doctor_id")
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  consultations  Int      @default(0)
  admissionsRec  Int      @default(0) @map("admissions_recommended")
  followUpsAdv   Int      @default(0) @map("follow_ups_advised")
  noShows        Int      @default(0)

  @@map("doctor_kpi")
}

model CampaignKPI {
  id            String   @id @default(uuid())
  campaignId    String   @map("campaign_id")
  leads         Int      @default(0)
  consultations Int      @default(0)
  admissions    Int      @default(0)
  revenue       Int      @default(0)
  spend         Int      @default(0)

  @@map("campaign_kpi")
}

model ExecutiveKPI {
  id                 String   @id @default(uuid())
  executiveId        String   @map("executive_id")
  periodStart        DateTime @map("period_start") @db.Date
  periodEnd          DateTime @map("period_end") @db.Date
  callsHandled       Int      @default(0) @map("calls_handled")
  leadsConverted     Int      @default(0) @map("leads_converted")
  followUpsCompleted Int      @default(0) @map("follow_ups_completed")
  avgResponseSec     Int      @default(0) @map("avg_response_sec")

  @@map("executive_kpi")
}

// ===========================================================================
// AUDIT  (security requirement)
// ===========================================================================

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String   // e.g. "lead.update", "booking.cancel"
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")

  actor StaffUser? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
